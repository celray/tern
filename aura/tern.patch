+// Tern does not carry search-provider attribution from the upstream configuration.
+export function ternSearchConfiguration(records) {
+  if (Services.appinfo.name !== "AuraTern") {
+    return records;
+  }
+  const attribution = new Set([
+    "client", "channel", "sourceid", "rls", "pc", "form", "t", "tag",
+    "partner", "partnerid", "campid", "toolid", "mkevt", "mkcid", "mkrid",
+    "customid", "trackingid", "ref", "from",
+  ]);
+  const result = structuredClone(records);
+  function clean(node) {
+    if (!node || typeof node !== "object") return;
+    if (Array.isArray(node)) {
+      node.forEach(clean);
+      return;
+    }
+    for (const key of Object.keys(node)) {
+      if (key === "partnerCode") {
+        node[key] = "";
+      } else if (key === "params" && Array.isArray(node[key])) {
+        node[key] = node[key].filter(param =>
+          !attribution.has(String(param.name).toLowerCase()) &&
+          !/partnerCode|firefox|mozilla/i.test(JSON.stringify(param))
+        );
+        node[key].forEach(clean);
+      } else {
+        clean(node[key]);
+      }
+    }
+  }
+  clean(result);
+  return result;
+}
+
