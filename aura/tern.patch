+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#tern-toolbar-edge {
+  display: none;
+}
+
+:root[tern-autohide] {
+  --tern-hidden-height: 0px;
+  --tern-fixed-height: 0px;
+
+  > body {
+    box-sizing: border-box;
+    padding-top: var(--tern-fixed-height);
+  }
+
+  #navigator-toolbox {
+    position: absolute;
+    inset: 0 0 auto;
+    z-index: 100;
+    background-color: var(--lwt-accent-color, Canvas);
+    background-image: var(--lwt-header-image, none);
+    background-position: top right;
+    background-repeat: no-repeat;
+    color: var(--lwt-text-color, CanvasText);
+    transform: translateY(calc(-1 * var(--tern-hidden-height)));
+    transition: transform 140ms ease-out;
+  }
+
+  &[tern-hide-tabs] #TabsToolbar {
+    order: -3;
+  }
+
+  &[tern-hide-navbar] #nav-bar {
+    order: -2;
+  }
+
+  &[tern-toolbars-shown] #navigator-toolbox {
+    transform: translateY(0);
+  }
+
+  #tern-toolbar-edge {
+    display: flex;
+    position: absolute;
+    inset: 0 0 auto;
+    height: 4px;
+    z-index: 101;
+    -moz-window-dragging: no-drag;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  :root[tern-autohide] #navigator-toolbox {
+    transition: none;
+  }
+}
+
+:root[tern-autohide] #urlbar {
+  transform: translateY(calc(-1 * var(--tern-hidden-height)));
+  transition: transform 140ms ease-out;
+}
+
+:root[tern-autohide][tern-toolbars-shown] #urlbar {
+  transform: translateY(0);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  :root[tern-autohide] #urlbar {
+    transition: none;
+  }
+}
