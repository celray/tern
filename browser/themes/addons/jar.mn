  content/builtin-themes/light/manifest.json       (light/manifest.json)

  content/builtin-themes/aiwindow/manifest.json       (aiwindow/manifest.json)
  content/builtin-themes/aiwindow/aiwindow-theme.css  (aiwindow/aiwindow-theme.css)

  content/builtin-themes/privatewindow/manifest.json            (privatewindow/manifest.json)

  content/builtin-themes/tern-auto/images/frame-dark.svg (../../branding/auratern/themes/tern-auto/images/frame-dark.svg)
  content/builtin-themes/tern-auto/images/frame-light.svg (../../branding/auratern/themes/tern-auto/images/frame-light.svg)
