  content/builtin-themes/tern-auto/manifest.json (../../branding/auratern/themes/tern-auto/manifest.json)
  content/builtin-themes/tern-auto/preview.svg (../../branding/auratern/themes/tern-auto/preview.svg)
  content/builtin-themes/tern-light/images/frame-light.svg (../../branding/auratern/themes/tern-light/images/frame-light.svg)
  content/builtin-themes/tern-light/images/icon-256.png (../../branding/auratern/themes/tern-light/images/icon-256.png)
  content/builtin-themes/tern-light/images/icon-32.png (../../branding/auratern/themes/tern-light/images/icon-32.png)
  content/builtin-themes/tern-light/manifest.json (../../branding/auratern/themes/tern-light/manifest.json)
  content/builtin-themes/tern-light/preview.svg (../../branding/auratern/themes/tern-light/preview.svg)
  content/builtin-themes/tern-dark/images/frame-dark.svg (../../branding/auratern/themes/tern-dark/images/frame-dark.svg)
