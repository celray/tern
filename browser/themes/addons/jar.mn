  content/builtin-themes/dark/preview.svg          (dark/preview.svg)
  content/builtin-themes/dark/icon.svg             (dark/icon.svg)
  content/builtin-themes/dark/manifest.json        (dark/manifest.json)

  content/builtin-themes/light/preview.svg         (light/preview.svg)
